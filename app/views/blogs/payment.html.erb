<%= stylesheet_link_tag 'payment_animation', media: 'all' %>
<script src="/assets/payment_animation.js"></script>

<div class="payment-modal" style="max-width: 400px; margin: 3em auto; background: #fff; border-radius: 12px; box-shadow: 0 4px 32px #0001; padding: 2em;">
  <h2 style="text-align:center;"><%= t('blogs.payment_title_with_price') %></h2>
  <%= form_with url: pay_blog_path(@blog), method: :post, local: true, html: { 'data-redirect-url': blog_path(@blog) } do |f| %>
    <div class="form-group" style="margin-bottom:1em;">
      <label for="card_number"><%= t('blogs.card_number') %></label>
      <%= text_field_tag :card_number, nil, id: 'card_number', class: 'form-control', maxlength: 19, pattern: '[0-9 ]{16,19}', required: true, placeholder: t('blogs.card_number_placeholder'), autocomplete: 'cc-number', inputmode: 'numeric', style: 'width:100%;padding:0.5em;' %>
    </div>
    <div class="form-group" style="margin-bottom:1em; display: flex; gap: 1em;">
      <div style="flex:1;">
        <label for="exp"><%= t('blogs.card_expiry') %></label>
        <%= text_field_tag :exp, nil, id: 'exp', class: 'form-control', maxlength: 5, pattern: '[0-9]{2}/[0-9]{2}', required: true, placeholder: t('blogs.card_expiry_placeholder'), autocomplete: 'cc-exp', inputmode: 'numeric', style: 'width:100%;padding:0.5em;' %>
      </div>
      <div style="flex:1;">
        <label for="cvc"><%= t('blogs.card_cvc') %></label>
        <%= text_field_tag :cvc, nil, id: 'cvc', class: 'form-control', maxlength: 4, pattern: '[0-9]{3,4}', required: true, placeholder: t('blogs.card_cvc_placeholder'), autocomplete: 'cc-csc', inputmode: 'numeric', style: 'width:100%;padding:0.5em;' %>
      </div>
    </div>

    <div style="display: flex; justify-content: center; margin-top: 2em;">
      <button type="submit" class="btn btn-primary" style="font-size:1.1em; min-width: 120px; text-align:center;"><%= t('blogs.pay') %></button>
    </div>
    <div style="display: flex; justify-content: center; margin-top: 2em;">
      <%= link_to t('buttons.cancel'), blog_path(@blog), class: 'btn btn-danger d-flex justify-content-center align-items-center', style: 'font-size:1.1em; min-width: 90px; display: flex; align-items: center; justify-content: center;' %>
    </div>
  <% end %>
</div>
