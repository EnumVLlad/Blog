<div style="max-width:500px; margin:40px auto;">
  <h2 style="text-align:center;">Редагування профілю користувача</h2>

  <% if @user.errors.any? %>
    <div style="background:#ffe6e6; color:#b30000; border:1px solid #b30000; border-radius:6px; padding:10px 16px; margin-bottom:18px;">
      <b>Помилки:</b>
      <ul>
        <% @user.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @user, url: user_path(@user), method: :patch, local: true do |f| %>
    <div style="margin-bottom:16px;">
      <%= f.label :email, 'Електронна пошта' %><br>
      <%= f.email_field :email, class: 'user-action-btn', style: 'width:100%;max-width:320px;' %>
    </div>
    <div style="margin-bottom:16px;">
      <%= f.label :password, 'Новий пароль' %><br>
      <%= f.password_field :password, class: 'user-action-btn', style: 'width:100%;max-width:320px;' %>
      <div style="font-size:0.92em;color:#888;">Залиште порожнім, якщо не потрібно змінювати пароль</div>
    </div>
    <div>
      <%= f.submit 'Зберегти зміни', class: 'user-action-btn' %>
      <%= link_to 'Назад', users_path, class: 'user-action-btn', style: 'background:#eee;color:#333;margin-left:12px;' %>
    </div>
  <% end %>
</div>
